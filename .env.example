# The WebSocket URL shown in your LiveKit Cloud project settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
# Keep these two values on the server only. Do not commit .env.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
# Give this privately to invited trial participants.
ROOM_ACCESS_CODE=replace_with_a_long_random_code
PORT=3001
# Optional. Comma-separated TCP peer IPs allowed to set X-Forwarded-For for /api/join
# rate limiting (for example 127.0.0.1 when Tailscale Serve or the Vite API proxy
# forwards the real client). Leave empty to use only req.socket.remoteAddress —
# forged X-Forwarded-For from untrusted peers is ignored. Do not list public clients.
# TRUSTED_PROXY_IPS=127.0.0.1
