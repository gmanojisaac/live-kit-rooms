# Target MVP (Next.js) — copy to .env.local and replace placeholders.
# Never commit real values. Never put secrets in NEXT_PUBLIC_* variables.

# --- Public (browser-safe) ---
NEXT_PUBLIC_LIVEKIT_URL=wss://your-dev-project.livekit.cloud
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# --- Server-only (Next.js Route Handlers / server modules) ---
LIVEKIT_API_KEY=replace_with_dev_livekit_api_key
LIVEKIT_API_SECRET=replace_with_dev_livekit_api_secret
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Owner session HMAC secret (min 32 chars). Server-only. Required for room creation.
OWNER_SESSION_SECRET=replace_with_long_random_owner_session_secret

# Optional absolute origin for invitation URLs (otherwise derived from the request).
# APP_BASE_URL=https://your-app.example

# Trusted proxies for client-IP rate limiting (comma-separated). Empty = ignore X-Forwarded-For.
# TRUSTED_PROXY_IPS=

# --- Room policy (PROVISIONAL — awaiting Product Owner decisions) ---
# D-02: who may create rooms? open | host_secret
ROOM_CREATION_MODE=open
# Required when ROOM_CREATION_MODE=host_secret
# ROOM_CREATION_SECRET=replace_with_host_creation_secret

# D-03: default room lifetime in minutes (management recommendation: 90)
ROOM_DEFAULT_EXPIRY_MINUTES=90

# D-04: invitation maximum uses (management recommendation: 6)
INVITE_DEFAULT_MAX_USES=6

# Room-creation abuse limit (conservative; not a frozen business policy)
ROOM_CREATION_RATE_LIMIT_MAX=10
ROOM_CREATION_RATE_LIMIT_WINDOW_MS=900000

# Join / access-code failure limit (management: 5 / 15 minutes)
JOIN_RATE_LIMIT_MAX_FAILURES=5
JOIN_RATE_LIMIT_WINDOW_MS=900000

# Short-lived LiveKit JWT ceiling in seconds (also capped by remaining room lifetime)
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Production Vercel must use separate production LiveKit credentials.
# Do NOT set NEXT_PUBLIC_LIVEKIT_API_SECRET, NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY,
# NEXT_PUBLIC_OWNER_SESSION_SECRET, or NEXT_PUBLIC_ROOM_CREATION_SECRET.

# ---------------------------------------------------------------------------
# Prototype (Vite + Express) — still used by npm run prototype:*
# Keep using LIVEKIT_URL for the prototype until that stack is retired.
# Prototype ROOM_ACCESS_CODE is local-only — never commit a real code.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=wss://your-dev-project.livekit.cloud
# ROOM_ACCESS_CODE=replace_with_a_long_random_code
# PORT=3001
# TRUSTED_PROXY_IPS=127.0.0.1
